# === L'AMI Platform - Variables d'environnement ===

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRATION_HOURS=24

# MongoDB
MONGO_URI=mongodb://localhost:27017

# URLs services (dev local)
GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
TICKET_SERVICE_URL=http://localhost:8085
NOTIF_SERVICE_URL=http://localhost:8086
IA_SERVICE_URL=http://localhost:8090
FRONTEND_URL=http://localhost:3000

# OAuth Google
# Creer un projet sur https://console.cloud.google.com/
# Credentials > OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA
LLM_PROVIDER=mock
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Securite
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
RABBITMQ_URL=amqp://lami:lami_secret@localhost:5672/
UPLOAD_DIR=./uploads
CATALOG_SERVICE_URL=http://localhost:8083
